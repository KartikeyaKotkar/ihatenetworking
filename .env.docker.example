# Self-host env. Copy to .env, fill as needed. All optional.
# App runs with empty file too (analytics off).
PORT=3000

# Optional: PostHog browser analytics. Leave empty to disable.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Notes (hardcoded upstream, left untouched for Vercel parity):
# - Canonical SITE_URL stays https://didyoupingit.com (src/lib/site.ts).
# - allowedDevOrigins LAN entry stays (next.config.ts, dev only).
